---
import { faq } from '../data/site';
---

<section id="duvidas" class="py-20 sm:py-28" aria-labelledby="duvidas-titulo">
  <div class="container-page grid gap-10 md:grid-cols-[0.8fr_2fr]">
    <div>
      <p class="eyebrow">.../Dúvidas...</p>
      <h2 id="duvidas-titulo" class="mt-3 font-mono text-2xl font-bold sm:text-3xl">Perguntas frequentes</h2>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold [&::-webkit-details-marker]:hidden">
              <h3>{item.question}</h3>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line font-mono transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-soft">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
