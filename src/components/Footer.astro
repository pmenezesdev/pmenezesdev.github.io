---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line py-8">
  <div class="container-page flex flex-col items-center justify-between gap-4 text-xs text-muted sm:flex-row">
    <p>© {year} {site.name} · {site.title} · {site.city}–{site.state}, Brasil</p>
    <a href="#inicio" class="font-mono transition-colors hover:text-paper">Voltar ao topo ↑</a>
  </div>
</footer>

<a
  href={whatsappUrl()}
  data-wa
  target="_blank"
  rel="noopener"
  class="fixed right-5 bottom-5 z-40 flex size-14 items-center justify-center rounded-full bg-whats text-ink shadow-lg shadow-black/40 transition-transform hover:scale-110"
  aria-label="Conversar no WhatsApp"
>
  <Icon name="whatsapp" size={28} />
</a>
